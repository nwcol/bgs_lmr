
log    = logs/$(Cluster).$(Process).log
error  = logs/$(Cluster).$(Process).err
output = logs/$(Cluster).$(Process).out

requirements    = (Target.HasCHTCStaging == true)
container_image = file:///staging/nwcollier/bgs_container.sif

executable = fit_Ne.sh

arguments = \
    $(chrom) \
    $(mutmodel) \
    --Ne 30000 \
    --B_unlinked $(B) \
    --n_cores 32 \
    --chunk_size 100 \
    --spacing 10000 \
    --window_size 1000 \
    --n_corrs 5 \
    --maxiter 20 \
    --save_corrs \
    --rich \
    --lookup_tbl lookup_tbl_eq_Ne10k.csv.gz \
    --rmap YRI_recombination_map_hapmap_format_hg38_chr_$(chrom).txt.gz \
    --umap $(mutmodel)_map_chr$(chrom).npy \
    --mask mask_chr$(chrom).bed.gz \
    --ndns ndns_YRI_chr$(chrom).npy \
    --bed \
        exons_lof_d1_chr$(chrom).bed.gz \
        exons_lof_d2_chr$(chrom).bed.gz \
        exons_lof_d3_chr$(chrom).bed.gz \
        exons_lof_d4_chr$(chrom).bed.gz \
        exons_lof_d5_chr$(chrom).bed.gz \
        exons_lof_d6_chr$(chrom).bed.gz \
        exons_lof_d7_chr$(chrom).bed.gz \
