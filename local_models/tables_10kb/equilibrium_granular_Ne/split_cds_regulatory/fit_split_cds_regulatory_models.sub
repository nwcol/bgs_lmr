        0.27682456 \
        0.27822116 \
        0.27793309 \
        0.28025591 \
        0.28027929 \
        0.28912967 \
        0.0 \
        0.0 \
    --verbose \
    --out $(outstem)_map.csv \
    --log_out $(outstem)_log.txt

transfer_input_files = \
    ../../data/recombination_maps/pyrho/YRI_recombination_map_hapmap_format_hg38_chr_$(chrom).txt.gz, \
    ../../data/masks/strict_$(mutmodel)/mask_chr$(chrom).bed.gz, \
    ../../data/lookup_tables/lookup_tbl_eq_Ne10k.csv.gz, \
    ../../data/annotations/functional/exons_lof_deciles/exons_lof_d1_chr$(chrom).bed.gz, \
    ../../data/annotations/functional/exons_lof_deciles/exons_lof_d2_chr$(chrom).bed.gz, \
    ../../data/annotations/functional/exons_lof_deciles/exons_lof_d3_chr$(chrom).bed.gz, \
    ../../data/annotations/functional/exons_lof_deciles/exons_lof_d4_chr$(chrom).bed.gz, \
