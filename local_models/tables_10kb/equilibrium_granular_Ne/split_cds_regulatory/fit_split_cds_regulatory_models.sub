        exons_lof_d10_chr$(chrom).bed.gz \
        exons_lof_d11_chr$(chrom).bed.gz \
        promoters_chr$(chrom).bed.gz \
        enhancers_chr$(chrom).bed.gz \ 
    --shapes \
        0.295103487 \
        0.255625629 \
        0.242348429 \
        0.212462538 \
        0.163208306 \
