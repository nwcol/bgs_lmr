        "../data/neu_pi_tables/split_cds_regulatory/{umap}/pi_tbl_YRI_chr{chrom}.csv.gz"
    shell:
        """
        python {input.script} \
            -i {input.ndns} \
            --mask {input.mask} \
            --elements {input.elements} \
            --scale 10000 \
            -o {output}
        """


rule compute_neutral_obs_pi_split_cds_phastcons:
    input:
        script = "../tools/py_scripts/build_neu_pi_table.py",
        ndns = "../data/ndns_arrays/ndns_YRI_chr{chrom}.npy",
        mask = "../data/masks/strict_{umap}/mask_chr{chrom}.bed.gz",
        elements = expand("../data/annotations/cds/lof_d{d}/cds_lof_d{d}_chr{{chrom}}.bed.gz", d=CDS_BINS) \
            + expand("../data/annotations/phastcons/top{b}/phastcons_top{b}_chr{{chrom}}.bed.gz", b=PHAST_BINS)
    output:
        "../data/neu_pi_tables/split_cds_phastcons/{umap}/pi_tbl_YRI_chr{chrom}.csv.gz"
    shell:
        """
        python {input.script} \
            -i {input.ndns} \
            --mask {input.mask} \
            --elements {input.elements} \
            --scale 10000 \
            -o {output}
        """


rule add_neutral_obs_pi:
    input:
        B_tbl = "tables_10kb_no_neu_pi/{demog}/{model}/{umap}/B_tbl_YRI_chr{chrom}_10kb.csv.gz",
        pi_tbl = "../data/neu_pi_tables/{model}/{umap}/pi_tbl_YRI_chr{chrom}.csv.gz"
    output:
        tbl = "tables_10kb/{demog}/{model}/{umap}/B_tbl_YRI_chr{chrom}_10kb.csv.gz"
    run:
        B_df = pandas.read_csv(input.B_tbl)
        pi_df = pandas.read_csv(input.pi_tbl)
        midpoints_B = np.mean([B_df["chromStart"], B_df["chromEnd"]], axis=0)
        midpoints_pi = np.mean([pi_df["chromStart"], pi_df["chromEnd"]], axis=0)
        include = np.array([x in midpoints_B for x in midpoints_pi]).astype(bool)
        # Check
        n_tot = np.array(B_df["num_sites"])
        n_del = np.array(B_df["del_sites"])
        n_neu = np.array(pi_df["neu_sites"])[include]
        assert np.all(n_neu == n_tot - n_del)
        B_df["neu_pi"] = np.array(pi_df["neu_pi"])[include]
        B_df.to_csv(output.tbl, index=False)


# Add a neutral E[pi] column to each table (this is trivial to compute using
# information in the table)
rule add_neutral_exp_pi_column:
    input:
        script = "../tools/py_scripts/compute_neu_pi.py",
        table = "tables_10kb_no_neu_pi/{demog}/{model}/{umap}/B_tbl_YRI_chr{chrom}_10kb.csv.gz"
    output:
        table = "dep_tables_10kb/{demog}/{model}/{umap}/B_tbl_YRI_chr{chrom}_10kb.csv.gz"
    shell:
        """
        python {input.script} -i {input.table} -o {output}
        """
