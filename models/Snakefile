# Add a neutral diversity column to 10kb landscape tables stored in
# tables_10kb_no_neu_pi/.

import numpy as np
import pandas


DEMOGS = [
    "equilibrium_granular_Ne",
    "equilibrium_single_Ne",
]
MODELS = [
    "merged_cds_regulatory",
    "merged_cds_phastcons",
    "split_cds_regulatory",
    "split_cds_phastcons",
]
UMAPS = [
    "roulette",
    "gnomad",
    "carlson",
]
CHROMS = list(range(1, 23))

# Auxiliary constants
PHAST_BINS = [f"{int(i*5)}-{int((i+1)*5)}" for i in range(12)]
CDS_BINS = list(range(1, 12))


rule all:
    input:
        expand("tables_10kb/{demog}/{model}/{umap}/B_tbl_YRI_chr{chrom}_10kb.csv.gz",
               demog=DEMOGS, model=MODELS, umap=UMAPS, chrom=CHROMS)


rule compute_neutral_obs_pi_merged_cds_regulatory:
    input:
        script = "../tools/py_scripts/build_neu_pi_table.py",
        ndns = "../data/ndns_arrays/ndns_YRI_chr{chrom}.npy",
        mask = "../data/masks/strict_{umap}/mask_chr{chrom}.bed.gz",
        elements = [
            "../data/annotations/cds/merged/cds_merged_chr{chrom}.bed.gz",
            "../data/annotations/regulatory/promoters/promoters_chr{chrom}.bed.gz",
            "../data/annotations/regulatory/enhancers/enhancers_chr{chrom}.bed.gz",
        ],
    output:
        "../data/neu_pi_tables/merged_cds_regulatory/{umap}/pi_tbl_YRI_chr{chrom}.csv.gz"
    shell:
        """
        python {input.script} \
            -i {input.ndns} \
            --mask {input.mask} \
            --elements {input.elements} \
            --scale 10000 \
            -o {output}
        """


rule compute_neutral_obs_pi_merged_cds_phastcons:
    input:
        script = "../tools/py_scripts/build_neu_pi_table.py",
        ndns = "../data/ndns_arrays/ndns_YRI_chr{chrom}.npy",
        mask = "../data/masks/strict_{umap}/mask_chr{chrom}.bed.gz",
        elements = [
            "../data/annotations/cds/merged/cds_merged_chr{chrom}.bed.gz",
        ] + expand("../data/annotations/phastcons/top{b}/phastcons_top{b}_chr{{chrom}}.bed.gz", b=PHAST_BINS)
    output:
        "../data/neu_pi_tables/merged_cds_phastcons/{umap}/pi_tbl_YRI_chr{chrom}.csv.gz"
    shell:
        """
        python {input.script} \
            -i {input.ndns} \
            --mask {input.mask} \
            --elements {input.elements} \
            --scale 10000 \
            -o {output}
        """


rule compute_neutral_obs_pi_split_cds_regulatory:
    input:
        script = "../tools/py_scripts/build_neu_pi_table.py",
        ndns = "../data/ndns_arrays/ndns_YRI_chr{chrom}.npy",
        mask = "../data/masks/strict_{umap}/mask_chr{chrom}.bed.gz",
